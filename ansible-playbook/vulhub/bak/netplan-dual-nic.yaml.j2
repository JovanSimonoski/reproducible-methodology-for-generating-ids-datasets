# Managed by Ansible - dual-NIC routing config
# Management NIC ({{ mgmt_iface }}): carries traffic ONLY for mgmt/VPN subnets.
# Internet NIC ({{ inet_iface }}): owns the default route for internet egress.
network:
  version: 2
  ethernets:
    {{ mgmt_iface }}:
      dhcp4: true
      dhcp-identifier: mac
      dhcp4-overrides:
        use-routes: false
      routes:
        - to: {{ mgmt_subnet }}
          via: {{ mgmt_gateway }}
{% for subnet in return_subnets %}
        - to: {{ subnet }}
          via: {{ mgmt_gateway }}
{% endfor %}
    {{ inet_iface }}:
      dhcp4: true
      dhcp-identifier: mac
      dhcp4-overrides:
        route-metric: 100
